{
  "name": "@orstrax/ui",
  "version": "1.0.1",
  "description": "Orstrax runtime theme, brand assets, and optional shared primitives",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.mjs",
      "require": "./dist/runtime.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "publish-theme": "node scripts/publish-theme.mjs",
    "build": "npm run publish-theme && tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "prepare": "npm run build"
  },
  "keywords": [
    "orstrax",
    "design-system",
    "ui-components",
    "react",
    "typescript"
  ],
  "author": "Orstrax LLC",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/orstrax/orstrax-ui.git"
  },
  "bugs": {
    "url": "https://github.com/orstrax/orstrax-ui/issues"
  },
  "homepage": "https://github.com/orstrax/orstrax-ui#readme",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  }
}
